# Lovable Cloud (no service-role key): send results to the app's endpoint.
# SCRAPER_INGEST_SECRET must match the secret set in Lovable (32+ characters).
ENERWISE_INGEST_URL=https://YOUR-APP.lovable.app/api/ingest-tariffs
SCRAPER_INGEST_SECRET=

# Or, with your own Supabase project: write directly (service-role key, never in frontend code)
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Essent and Vattenfall only show prices for a real household address. Supply
# prices are the same nationwide, so any real address works.
# Keep it here and in GitHub Secrets only; it is never stored with the prices.
REFERENCE_POSTCODE=
REFERENCE_HOUSE_NUMBER=
# Letter/extra part of the house number, if any (e.g. 12B -> B)
REFERENCE_HOUSE_NUMBER_ADDITION=

# Optional
# SAVE_DEBUG_HTML=1
