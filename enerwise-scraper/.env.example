# Supabase -> Project Settings -> API. The service-role key can write to every
# table: keep it ONLY here and in GitHub Secrets, never in Lovable/frontend code.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Essent and Vattenfall only show prices for a real household address. Supply
# prices are the same nationwide, so any real address works (e.g. your own).
# Keep it here and in GitHub Secrets only; it is never stored with the prices.
REFERENCE_POSTCODE=
REFERENCE_HOUSE_NUMBER=
# Letter/extra part of the house number, if any (e.g. 141M -> M)
REFERENCE_HOUSE_NUMBER_ADDITION=

# Optional
# SAVE_DEBUG_HTML=1
